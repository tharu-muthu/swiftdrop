# Copy this file to backend/.env. Never commit the real file.
# Each developer selects their OWN Neon branch, database and role in Neon > Connect.
# Runtime can use the pooled endpoint; Flyway automatically removes -pooler from its hostname.
# Replace every YOUR_* value. Keep user/password OUT of the JDBC URL.
# Java properties syntax: no export, no surrounding quotes; escape a literal backslash as \\.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_ENDPOINT-pooler.YOUR_REGION.aws.neon.tech:5432/YOUR_DATABASE?sslmode=require&channelBinding=require
SPRING_DATASOURCE_USERNAME=YOUR_NEON_ROLE
SPRING_DATASOURCE_PASSWORD=YOUR_NEON_PASSWORD

# Optional explicit direct endpoint: copy it from the SAME branch/compute/database in Neon Connect.
# Leave these commented to derive the direct URL and reuse the runtime role/password.
# SPRING_FLYWAY_URL=jdbc:postgresql://YOUR_ENDPOINT.YOUR_REGION.aws.neon.tech:5432/YOUR_DATABASE?sslmode=require&channelBinding=require
# SPRING_FLYWAY_USER=YOUR_MIGRATION_ROLE
# SPRING_FLYWAY_PASSWORD=YOUR_MIGRATION_PASSWORD
# RabbitMQ settings come from the private root .env used for local infrastructure.

# IAM-02/07. Generate the signing key with scripts/setup-auth.ps1; never use this placeholder.
AUTH_JWT_SECRET=YOUR_RANDOM_BASE64_32_BYTE_SIGNING_KEY
AUTH_JWT_ISSUER=https://swiftdrop.local
AUTH_JWT_AUDIENCE=swiftdrop-api
AUTH_ACCESS_TTL=10m
AUTH_REFRESH_TTL=7d
# Only for local HTTP development. Production uses false and exact HTTPS origins.
AUTH_LOCALHOST_DEVELOPMENT=true
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional dedicated 32-byte Base64 key for encrypting M9 webhook secrets.
# If omitted, the backend derives a context-separated key from AUTH_JWT_SECRET.
# WEBHOOK_SECRET_ENCRYPTION_KEY=YOUR_BASE64_32_BYTE_KEY

# IAM-03 Google OAuth. Get credentials from Google Cloud Console when enabled.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
# Docker default; for Vite use http://127.0.0.1:5173 instead.
# Match Google Cloud's redirect URI to this origin + /login/oauth2/code/google.
GOOGLE_FRONTEND_ORIGIN=http://localhost:8080

# IAM-08 password recovery. Docker Compose overrides host/origin for its local Mailpit inbox.
# For Maven on the host, run Mailpit on localhost:1025 and open its inbox at localhost:8025.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@swiftdrop.local
RESET_FRONTEND_ORIGIN=http://localhost:8080
# For a real SMTP provider, set these privately as required:
# MAIL_USERNAME=YOUR_SMTP_USERNAME
# MAIL_PASSWORD=YOUR_SMTP_PASSWORD
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true

# To send real password-reset messages through a Gmail account, set these in
# private backend/.env. They override Docker Compose's local Mailpit host/port.
# The sending Gmail account needs 2-Step Verification and a Google App Password.
# Google sign-in client ID/secret are separate and cannot send mail.
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=YOUR_SENDING_GMAIL_ADDRESS
# SPRING_MAIL_PASSWORD=YOUR_GOOGLE_APP_PASSWORD_WITHOUT_SPACES
# SPRING_MAIL_SMTP_AUTH=true
# SPRING_MAIL_SMTP_STARTTLS=true
# SPRING_MAIL_SMTP_STARTTLS_REQUIRED=true
# MAIL_FROM=YOUR_SENDING_GMAIL_ADDRESS
