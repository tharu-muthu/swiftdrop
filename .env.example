# Copy to .env at the repository root. Replace both blank passwords.
# Use separate, locally generated alphanumeric values (at least 24 characters).
# Never commit .env. These are development credentials, not production secrets.
# This root file configures local Compose infrastructure, not a developer's Neon branch.
# For Neon, use backend/.env.example -> backend/.env with SPRING_DATASOURCE_* keys.
POSTGRES_DB=swiftdrop
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=
# Optional query parameters (e.g. ?sslmode=require for cloud PostgreSQL like Neon)
POSTGRES_PARAMS=
RABBITMQ_USER=swiftdrop
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=swiftdrop

# Host ports. The database uses 5433 to avoid an existing local PostgreSQL.
FRONTEND_PORT=8080
BACKEND_PORT=8081
POSTGRES_PORT=5433
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Local backend uses these; Compose overrides container hostnames.
POSTGRES_HOST=localhost
RABBITMQ_HOST=localhost
# Vite's optional BACKEND_URL belongs in frontend/.env (see frontend/.env.example).
# Backend-only signing key for the full Compose option; scripts/setup-auth.ps1 -Compose configures it privately.
AUTH_JWT_SECRET=
GOOGLE_ENABLED=false
# Set these only when Google OAuth has been configured for the environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_FRONTEND_ORIGIN=http://localhost:8080
